{application,pollutiondb,
    [{modules,
         ['Elixir.Pollutiondb','Elixir.Pollutiondb.Application',
          'Elixir.Pollutiondb.Mailer','Elixir.Pollutiondb.Parser',
          'Elixir.Pollutiondb.Reading','Elixir.Pollutiondb.Repo',
          'Elixir.Pollutiondb.Station','Elixir.PollutiondbWeb',
          'Elixir.PollutiondbWeb.CoreComponents',
          'Elixir.PollutiondbWeb.Endpoint','Elixir.PollutiondbWeb.ErrorHTML',
          'Elixir.PollutiondbWeb.ErrorJSON','Elixir.PollutiondbWeb.Gettext',
          'Elixir.PollutiondbWeb.Layouts',
          'Elixir.PollutiondbWeb.PageController',
          'Elixir.PollutiondbWeb.PageHTML',
          'Elixir.PollutiondbWeb.ReadingLive','Elixir.PollutiondbWeb.Router',
          'Elixir.PollutiondbWeb.StationLive',
          'Elixir.PollutiondbWeb.StationRangeLive',
          'Elixir.PollutiondbWeb.Telemetry']},
     {compile_env,
         [{pollutiondb,['Elixir.PollutiondbWeb.Gettext'],error},
          {pollutiondb,[dev_routes],{ok,true}}]},
     {optional_applications,[]},
     {applications,
         [kernel,stdlib,elixir,logger,runtime_tools,ecto_sql,ecto_sqlite3,
          phoenix,phoenix_html,phoenix_live_reload,phoenix_live_view,
          phoenix_live_dashboard,esbuild,tailwind,swoosh,finch,
          telemetry_metrics,telemetry_poller,gettext,jason,dns_cluster,
          bandit]},
     {description,"pollutiondb"},
     {registered,[]},
     {vsn,"0.1.0"},
     {mod,{'Elixir.Pollutiondb.Application',[]}}]}.
